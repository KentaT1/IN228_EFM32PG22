# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: IN232
label: IN232
description: |
  INA228 on I2C (sensor bus) with VCOM printf. Wire INA228 SDA/SCL to BRD2503A
  I2C1 sensor pins (SDA=PD02, SCL=PD03). Adjust Rshunt and Imax in app.c to match your board.
category: Example|Platform
filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Beginner]
package: platform
quality: production
source:
- {path: app.c}
- {path: main.c}
- {path: ina228.c}
include:
- path: .
  file_list:
  - {path: app.h}
  - {path: ina228.h}
sdk: {id: gecko_sdk, version: 4.1.4}
toolchain_settings: []
component:
- {id: EFM32PG22C200F512IM40}
- {id: board_control}
- {id: brd2503a}
- {id: device_init}
- instance: [sensor]
  id: i2cspm
- {id: iostream}
- instance: [vcom]
  id: iostream_eusart
- {id: iostream_retarget_stdio}
- {id: iostream_stdlib_config}
- {id: sl_system}
define:
- {name: DEBUG_EFM}
configuration:
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}
- {name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF, value: '1'}
ui_hints: {}

